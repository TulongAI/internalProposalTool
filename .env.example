# Anthropic (Claude) API key, used only server-side by app/api/claude/route.ts.
# Never exposed to the browser.
tulong-proposal-tool-prod=

# Supabase project storing the `proposals` table (see lib/store.ts). The
# service_role key bypasses Row Level Security by design — the proposals
# table has RLS enabled with no policies, so this is the only key that can
# read/write it. Get both from the Supabase dashboard: Project Settings > API.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
