# Anthropic (Claude) API key, used only server-side by app/api/claude/route.ts.
# Never exposed to the browser.
tulong-proposal-tool-prod=

# Vercel KV (Storage > KV in the Vercel dashboard fills these in automatically
# when the integration is linked to the project). Without these set, the app
# falls back to an in-memory store for local development only — data will not
# persist across server restarts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
